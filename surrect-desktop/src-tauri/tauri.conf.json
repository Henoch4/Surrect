{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Surrect",
  "version": "0.1.0",
  "identifier": "com.surrect.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "Surrect", "width": 1280, "height": 800, "minWidth": 1024, "minHeight": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
    "externalBin": ["binaries/surrect", "binaries/photorec"],
    "resources": [
      "binaries/63/*",
      "binaries/cygwin1.dll",
      "binaries/cygz.dll",
      "binaries/cygjpeg-8.dll",
      "binaries/cygiconv-2.dll",
      "binaries/cygncursesw-10.dll",
      "binaries/cyggcc_s-seh-1.dll",
      "binaries/cygewf-2.dll",
      "binaries/COPYING.txt",
      "binaries/THIRD_PARTY.txt"
    ]
  }
}
